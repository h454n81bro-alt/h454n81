# Dev-mode image for local testing (hot reload via tsx watch + Vite).
# For a production build, use the root Dockerfile instead.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN npm install -g corepack@latest && corepack pnpm install

ENV NODE_ENV=development
EXPOSE 3000

# `push --force` is idempotent for the first run (empty DB), but drizzle-kit
# can misdetect an already-correct primary key as a pending change on repeat
# pushes against a populated DB and error out. That's harmless (the schema is
# already correct), so don't let it block starting the dev server on restarts.
CMD ["sh", "-c", "npx drizzle-kit push --config drizzle.config.ts --force; pnpm dev"]
